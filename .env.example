# Local model (default). Pull first: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional cloud fallback for hard reasoning. Leave blank to stay local.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Timezone used by the clock tool and morning brief
JARVIS_TZ=America/Denver

# Vault is the only folder file tools may touch
JARVIS_VAULT=./vault

# SQLite checkpointer
JARVIS_DB=./vault/jarvis.db

# Optional search. DuckDuckGo works with no key.
# TAVILY_API_KEY=

# Home Assistant (Phase 3)
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# Google Workspace MCP is configured separately in mcp.json
